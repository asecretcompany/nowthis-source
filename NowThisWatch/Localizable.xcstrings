    "watch.locked.a11y" : {
      "comment" : "VoiceOver label for the locked sheet on the watch. Spoken, not shown — the Settings path is spelled out with commas rather than the arrow the visible label uses, because VoiceOver cannot read an arrow. Name the Settings app whatever it is called in your language.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufgaben anzusehen ist immer kostenlos. Um die Aufgabenbearbeitung auf der Apple Watch freizuschalten, öffne auf deinem iPhone Einstellungen und dann Entwicklung unterstützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viewing tasks is always free. To unlock Apple Watch task editing, open Settings, Support Development, on your iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ver tareas siempre es gratis. Para desbloquear la edición de tareas en el Apple Watch, abre Ajustes y, después, Apoyar el desarrollo en tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La consultation des tâches est toujours gratuite. Pour déverrouiller la modification des tâches sur l’Apple Watch, ouvrez Réglages, puis Soutenir le développement, sur votre iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualizzare le attività è sempre gratuito. Per sbloccare la modifica delle attività su Apple Watch, apri Impostazioni e poi Sostieni lo sviluppo sul tuo iPhone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taken bekijken is altijd gratis. Open Instellingen en daarna Ontwikkeling steunen op je iPhone om taakbewerking op de Apple Watch te ontgrendelen."
          }
        }
      }
    },
    "watch.locked.body" : {
      "comment" : "Shown on the watch when an edit is attempted without NowThis Supporter. The arrow is a navigation path on the iPhone; use whatever separator your language's own Settings paths use. Its spoken twin spells the same path out in words, because VoiceOver cannot read an arrow — the two are deliberately different and must stay that way.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufgaben anzusehen ist immer kostenlos. Zum Bearbeiten öffnest du auf deinem iPhone Einstellungen → Entwicklung unterstützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viewing tasks is always free. For editing, open Settings → Support Development on your iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ver tareas siempre es gratis. Para editarlas, abre Ajustes → Apoyar el desarrollo en tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La consultation des tâches est toujours gratuite. Pour les modifier, ouvrez Réglages → Soutenir le développement sur votre iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualizzare le attività è sempre gratuito. Per modificarle, apri Impostazioni → Sostieni lo sviluppo sul tuo iPhone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taken bekijken is altijd gratis. Open Instellingen → Ontwikkeling steunen op je iPhone om taken te bewerken."
          }
        }
      }
    },
