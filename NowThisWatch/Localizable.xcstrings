    "Delivery could not be confirmed. Check your iPhone before trying again." : {
      "comment" : "Watch edit delivery feedback. A delivery failure may be ambiguous: the phone may already have applied the edit.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Übertragung konnte nicht bestätigt werden. Prüfe dein iPhone, bevor du es erneut versuchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delivery could not be confirmed. Check your iPhone before trying again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido confirmar la entrega. Comprueba tu iPhone antes de volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’envoi n’a pas pu être confirmé. Vérifiez votre iPhone avant de réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile confermare l’invio. Controlla il tuo iPhone prima di riprovare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bezorging kon niet worden bevestigd. Controleer je iPhone voordat je het opnieuw probeert."
          }
        }
      }
    },
