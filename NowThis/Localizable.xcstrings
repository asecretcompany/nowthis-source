    "Smart Lists always appears first. Drag to reorder, tap the eye to hide sections." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Intelligente Listen“ steht immer an erster Stelle. Ziehe zum Umsortieren, tippe auf das Auge, um Bereiche auszublenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Listas inteligentes» siempre aparece primero. Arrastra para reordenar y toca el ojo para ocultar secciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Listes intelligentes » apparaît toujours en premier. Faites glisser pour réorganiser, touchez l'œil pour masquer des sections."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Elenchi intelligenti» appare sempre per primo. Trascina per riordinare, tocca l'occhio per nascondere le sezioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Slimme lijsten' staat altijd bovenaan. Sleep om te herschikken, tik op het oog om secties te verbergen."
          }
        }
      }
    },
