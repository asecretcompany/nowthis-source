    "Older NowThis versions can remove photos when saving tasks. Update every device that edits tasks with photos." : {
      "comment" : "Versions before task photo support omit ATTACH when rewriting tasks. Users should update all editing devices before sharing task photos.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ältere NowThis-Versionen können Fotos beim Speichern von Aufgaben entfernen. Aktualisiere jedes Gerät, auf dem Aufgaben mit Fotos bearbeitet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Older NowThis versions can remove photos when saving tasks. Update every device that edits tasks with photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las versiones anteriores de NowThis pueden eliminar fotos al guardar tareas. Actualiza todos los dispositivos que editen tareas con fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les anciennes versions de NowThis peuvent supprimer les photos lors de l’enregistrement des tâches. Mettez à jour tous les appareils qui modifient des tâches avec photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le versioni precedenti di NowThis possono rimuovere le foto quando salvano le attività. Aggiorna tutti i dispositivi usati per modificare attività con foto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oudere versies van NowThis kunnen foto's verwijderen bij het opslaan van taken. Werk elk apparaat bij waarop je taken met foto's bewerkt."
          }
        }
      }
