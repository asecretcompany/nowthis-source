        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De vervaldatum voor nieuwe taken die je aan deze lijst toevoegt"
          }
        }
      }
    },
    "The due date applied to new tasks. Individual lists can override this, and you can change it per task." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fälligkeitsdatum, das neue Aufgaben erhalten. Einzelne Listen können das überschreiben, und du kannst es bei jeder Aufgabe ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fecha de vencimiento que se aplica a las tareas nuevas. Cada lista puede tener la suya y puedes cambiarla en cada tarea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La date d'échéance appliquée aux nouvelles tâches. Chaque liste peut la remplacer, et vous pouvez la modifier tâche par tâche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La data di scadenza applicata alle nuove attività. I singoli elenchi possono sostituirla e puoi cambiarla per ogni attività."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De vervaldatum die nieuwe taken krijgen. Losse lijsten kunnen dit overschrijven en je kunt het per taak wijzigen."
          }
        }
      }
    },
    "The original could not be saved on this device. Check available storage and try again." : {
      "comment" : "Alert when the local original cache cannot be written; the requested original is not silently discarded.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Original konnte nicht auf diesem Gerät gespeichert werden. Prüfe den verfügbaren Speicherplatz und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The original could not be saved on this device. Check available storage and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido guardar el original en este dispositivo. Comprueba el espacio disponible e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’enregistrer l’original sur cet appareil. Vérifiez l’espace disponible et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare l’originale su questo dispositivo. Controlla lo spazio disponibile e riprova."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het origineel kan niet op dit apparaat worden bewaard. Controleer de beschikbare opslagruimte en probeer het opnieuw."
          }
        }
      }
    },
    "The photo could not be loaded. Check your photo library access and try again." : {
