    "NowThis needs calendar access to add events. Please enable it in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NowThis benötigt Zugriff auf den Kalender, um Ereignisse hinzuzufügen. Bitte aktiviere ihn in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NowThis necesita acceso al calendario para añadir eventos. Actívalo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NowThis a besoin d'accéder au calendrier pour ajouter des événements. Activez cet accès dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NowThis ha bisogno dell'accesso al calendario per aggiungere eventi. Attivalo in Impostazioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NowThis heeft toegang tot je agenda nodig om activiteiten toe te voegen. Schakel dit in bij Instellingen."
          }
        }
      }
    },
    "NowThis couldn’t safely open your saved tasks yet. Please bring the app to the foreground and tap Retry." : {
      "comment" : "Shown on the saved-task recovery screen when iOS refuses extra execution time for opening the database. Retry is the existing button.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NowThis konnte deine gespeicherten Aufgaben noch nicht sicher öffnen. Hole die App in den Vordergrund und tippe auf „Erneut versuchen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NowThis aún no ha podido abrir tus tareas guardadas de forma segura. Vuelve a poner la app en primer plano y toca «Reintentar»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NowThis n’a pas encore pu ouvrir vos tâches enregistrées en toute sécurité. Ramenez l’app au premier plan et touchez « Réessayer »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NowThis non è ancora riuscita ad aprire in sicurezza le tue attività salvate. Riporta l’app in primo piano e tocca «Riprova»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NowThis kon je opgeslagen taken nog niet veilig openen. Zet de app op de voorgrond en tik op ‘Probeer opnieuw’."
          }
        }
      }
    },
