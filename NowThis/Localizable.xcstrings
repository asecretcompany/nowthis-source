    "intent.quickAdd.description" : {
      "comment" : "Shortcuts description for the quick-add action. The parser is English-only and stays that way, so the copy says so outright rather than inviting the user's own language — translate the sentence but leave the quoted example in English exactly as written.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt eine Aufgabe aus einem englischen Satz wie „buy milk tomorrow at 5pm“ hinzu. Datums- und Zeitangaben werden nur auf Englisch erkannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adds a task from an English phrase like \"buy milk tomorrow at 5pm\". Dates and times are only recognised in English."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una tarea a partir de una frase en inglés como «buy milk tomorrow at 5pm». Las fechas y las horas solo se reconocen en inglés."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute une tâche à partir d'une phrase en anglais comme « buy milk tomorrow at 5pm ». Les dates et les heures ne sont reconnues qu'en anglais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge un'attività da una frase in inglese come «buy milk tomorrow at 5pm». Date e orari vengono riconosciuti solo in inglese."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt een taak toe op basis van een Engelse zin zoals 'buy milk tomorrow at 5pm'. Datums en tijden worden alleen in het Engels herkend."
          }
        }
      }
    },
