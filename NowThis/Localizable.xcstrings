    "Controls how NowThis alerts you. Banners appear at the top of the screen. Badges show a count on the app icon." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt fest, wie NowThis dich benachrichtigt. Banner erscheinen oben am Bildschirm. Kennzeichen zeigen eine Anzahl auf dem App-Symbol."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla cómo te avisa NowThis. Las tiras aparecen en la parte superior de la pantalla. Los globos muestran un número en el icono de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détermine la façon dont NowThis vous alerte. Les bannières apparaissent en haut de l'écran. Les pastilles affichent un nombre sur l'icône de l'app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Determina come NowThis ti avvisa. Gli striscioni appaiono in cima allo schermo. I badge mostrano un numero sull'icona dell'app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bepaalt hoe NowThis je waarschuwt. Banners verschijnen boven aan het scherm. Badges tonen een aantal op het app-symbool."
          }
        }
      }
    },
