          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa attività ha già cinque foto. Rimuovine una per aggiungerne un’altra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze taak heeft al vijf foto’s. Verwijder een foto om er nog een toe te voegen."
          }
        }
      }
    },
    "This task is no longer available. The photo was not added." : {
