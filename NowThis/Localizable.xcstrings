    "pro.ios.body" : {
      "comment" : "Permanent promise: all functional iOS features, including future ones, require no Supporter. Icons are optional cosmetics.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle iOS-Produktivitätsfunktionen, auch künftige Ergänzungen, sind in der App enthalten. Supporter ist eine optionale Möglichkeit, die Weiterentwicklung zu unterstützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All iOS productivity features, including future additions, are included with the app. Supporter is an optional way to support continued development."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las funciones de productividad de iOS, incluidas las que se añadan en el futuro, están incluidas en la app. Supporter es una forma opcional de apoyar el desarrollo continuo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les fonctionnalités de productivité iOS, y compris les ajouts futurs, sont incluses dans l’app. Supporter est un moyen facultatif de soutenir la poursuite du développement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le funzioni di produttività di iOS, comprese quelle future, sono incluse nell’app. Supporter è un modo facoltativo per sostenere lo sviluppo continuo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle productiviteitsfuncties van iOS, ook toekomstige toevoegingen, zijn inbegrepen bij de app. Supporter is een optionele manier om de verdere ontwikkeling te steunen."
          }
        }
      }
    },
    "pro.legacy.body" : {
      "comment" : "Explicit rename announcement: original Pro and Watch unlock purchases automatically become Lifetime Supporter with all future benefits, without paying again.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro heißt jetzt Supporter. Frühere Käufe von Pro oder der Freischaltung für die Apple Watch wurden automatisch in Supporter auf Lebenszeit umgewandelt. Alle aktuellen und zukünftigen Supporter-Funktionen und Motive sind enthalten. Ein Abo oder erneuter Kauf ist nicht nötig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro has been renamed to Supporter. Previous Pro and Apple Watch unlock purchases have automatically become Lifetime Supporter, including all current and future Supporter features and artwork. No subscription or repurchase is needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro ahora se llama Supporter. Las compras anteriores de Pro o del desbloqueo del Apple Watch se han convertido automáticamente en Supporter de por vida, con todas las funciones y diseños de Supporter actuales y futuros. No necesitas suscribirte ni volver a comprar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro s’appelle désormais Supporter. Les achats antérieurs de Pro ou du déblocage Apple Watch ont automatiquement été convertis en Supporter à vie, avec toutes les fonctionnalités et tous les visuels Supporter actuels et futurs. Aucun abonnement ni nouvel achat n’est nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro ora si chiama Supporter. Gli acquisti precedenti di Pro o dello sblocco per Apple Watch sono stati convertiti automaticamente in Supporter a vita, con tutte le funzioni e le grafiche Supporter attuali e future. Non serve un abbonamento né acquistare di nuovo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro heet nu Supporter. Eerdere aankopen van Pro of de Apple Watch-ontgrendeling zijn automatisch omgezet naar Supporter voor altijd, met alle huidige en toekomstige Supporter-functies en illustraties. Een abonnement of nieuwe aankoop is niet nodig."
          }
        }
      }
    },
    "pro.lifetime.notice" : {
