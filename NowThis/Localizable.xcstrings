          }
        }
      }
    },
    "You can view photos in this list, but you no longer have permission to change them." : {
      "comment" : "Alert when list edit permission is lost while adding or removing a task photo.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst Fotos in dieser Liste ansehen, hast aber keine Berechtigung mehr, sie zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can view photos in this list, but you no longer have permission to change them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes ver las fotos de esta lista, pero ya no tienes permiso para modificarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
