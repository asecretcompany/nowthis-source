    "disclosure.translation.body" : {
      "comment" : "Body of the sheet shown once per language telling the user this translation was made by AI. Shown in the language being described, so write it as a plain statement about the text the reader is looking at. Two things must survive translation exactly: that the AI was used while BUILDING the app, not while running it, and that the user's own data never reaches an AI service. 'as part of building the app' is the load-bearing phrase — 'this app uses AI' would be a different and untrue claim. 'NowThis' is a product name and is never translated.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NowThis ist auf Englisch geschrieben. Die anderen Sprachen wurden bei der Entwicklung der App von einer KI übersetzt – was du eingibst, wird niemals an einen KI-Dienst gesendet. Manche Formulierungen können trotzdem falsch sein oder zwar richtig, aber unnatürlich klingen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "NowThis is written in English. The other languages were translated by AI as part of building the app — nothing you type is ever sent to an AI service. Some wording may still be wrong, or correct but unnatural."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NowThis está escrito en inglés. Los demás idiomas se tradujeron con IA durante el desarrollo de la app: nada de lo que escribes llega nunca a un servicio de IA. Puede que alguna expresión sea incorrecta, o correcta pero poco natural."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NowThis est écrit en anglais. Les autres langues ont été traduites par une IA pendant le développement de l'app. Rien de ce que vous écrivez n'est envoyé à un service d'IA. Certaines formulations peuvent encore être inexactes, ou correctes mais peu naturelles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NowThis è scritto in inglese. Le traduzioni nelle altre lingue sono state fatte da un'intelligenza artificiale durante lo sviluppo dell'app: quello che scrivi non viene mai inviato a un servizio di IA. Qualche frase potrebbe comunque risultare sbagliata, oppure corretta ma poco naturale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NowThis is in het Engels geschreven. De andere talen zijn tijdens de ontwikkeling van de app door AI vertaald — wat je typt, gaat nooit naar een AI-dienst. Het kan zijn dat sommige teksten niet helemaal kloppen, of wel kloppen maar onnatuurlijk klinken."
          }
        }
      }
    },
    "disclosure.translation.dismiss" : {
      "comment" : "Button that dismisses the machine-translation disclosure sheet. A VERB, and the only action on the sheet — it acknowledges having read it and closes. Not 'Next' (nothing follows) and not 'OK' if your language distinguishes them. Toolbar buttons are narrow: keep it to one short word.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortfahren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Continue"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continua"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doorgaan"
          }
        }
      }
    },
    "disclosure.translation.invitation" : {
      "comment" : "Second paragraph of the machine-translation disclosure sheet, inviting the user to report bad wording. Keep it short and non-apologetic — it is an invitation, not a disclaimer.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn sich etwas holprig liest, sag uns Bescheid – so ist es am schnellsten behoben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If something reads badly, telling us is the fastest way to get it fixed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si algo no suena bien, avisarnos es la forma más rápida de corregirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si une formulation sonne faux, dites-le-nous : c'est le moyen le plus rapide de la corriger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se qualcosa non ti suona bene, segnalarcelo è il modo più rapido per correggerlo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klinkt er iets krom? Laat het ons weten — dat is de snelste manier om het te verbeteren."
          }
        }
      }
    },
    "disclosure.translation.report" : {
