    "caldav.error.conflict" : {
      "comment" : "Sync error for HTTP 412. Someone else changed the same task first, so this device's version was not saved.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufgabe wurde auf dem Server geändert. Bitte aktualisiere und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The task was modified on the server. Please refresh and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarea se ha modificado en el servidor. Actualiza e inténtalo de nuevo."
