            "value" : "Nur in TestFlight und Entwicklungsbuilds sichtbar. Aktiviere die Option, um den Kaufbutton für NowThis Supporter zu sehen; deaktiviere sie für den kostenlosen Testerzugang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only visible in TestFlight and development builds. Turn on to reach the NowThis Supporter purchase button; turn off to return to free tester access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo aparece en TestFlight y versiones de desarrollo. Actívala para ver el botón de compra de NowThis Supporter; desactívala para volver al acceso gratuito de tester."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visible uniquement dans TestFlight et les versions de développement. Activez cette option pour afficher le bouton d’achat NowThis Supporter ; désactivez-la pour retrouver l’accès gratuit des testeurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visibile solo in TestFlight e nelle build di sviluppo. Attivala per vedere il pulsante di acquisto di NowThis Supporter; disattivala per tornare all’accesso gratuito per tester."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen zichtbaar in TestFlight en ontwikkelbuilds. Schakel dit in om de aankoopknop voor NowThis Supporter te zien; schakel het uit voor de gratis testertoegang."
          }
        }
      }
    },
    "support.qa.forcePaywall.hint" : {
