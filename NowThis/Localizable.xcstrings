    "Type a task name. Use !high for priority, #list for list, @tag for tags, or date words like tomorrow" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib einen Aufgabennamen ein. Verwende !high für die Priorität, #list für die Liste, @tag für Tags oder Datumswörter wie tomorrow"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe el nombre de una tarea. Usa !high para la prioridad, #list para la lista, @tag para las etiquetas, o palabras de fecha como tomorrow"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez un nom de tâche. Utilisez !high pour la priorité, #list pour la liste, @tag pour les tags, ou des mots de date comme tomorrow"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
