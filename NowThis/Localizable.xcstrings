    "settings.sync.window.footer" : {
      "comment" : "Footer under the sync settings explaining that the sync window limits how far back completed tasks are fetched. The placeholder is a whole number of months.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Es werden nur erledigte Aufgaben aus dem letzten Monat synchronisiert. Aktive Aufgaben werden immer synchronisiert."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Es werden nur erledigte Aufgaben aus den letzten %lld Monaten synchronisiert. Aktive Aufgaben werden immer synchronisiert."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Only completed tasks from the last month will be synced. Active tasks are always synced."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Only completed tasks from the last %lld months will be synced. Active tasks are always synced."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Solo se sincronizarán las tareas completadas del último mes. Las tareas activas se sincronizan siempre."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Solo se sincronizarán las tareas completadas de los últimos %lld meses. Las tareas activas se sincronizan siempre."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
