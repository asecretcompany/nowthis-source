    "%@ needs re-authentication. Sync is paused until you update your account in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ muss erneut authentifiziert werden. Die Synchronisierung pausiert, bis du dein Konto in den Einstellungen aktualisierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ necesita volver a autenticarse. La sincronización está en pausa hasta que actualices tu cuenta en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ doit être réauthentifié. La synchronisation est en pause jusqu'à ce que vous mettiez votre compte à jour dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ deve essere autenticato di nuovo. La sincronizzazione è in pausa finché non aggiorni il tuo account in Impostazioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ moet opnieuw worden geverifieerd. De synchronisatie is gepauzeerd tot je je account bijwerkt in Instellingen."
          }
        }
      }
    },
