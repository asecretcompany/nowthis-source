    "Unlock your device, free up storage space, or restart it before tapping Retry. Your saved data has been left in place." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperre dein Gerät, schaffe Speicherplatz oder starte es neu, bevor du auf „Erneut versuchen“ tippst. Deine gespeicherten Daten bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquea el dispositivo, libera espacio o reinícialo antes de tocar «Reintentar». Tus datos guardados siguen intactos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouillez votre appareil, libérez de l’espace ou redémarrez-le avant de toucher « Réessayer ». Vos données restent préservées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sblocca il dispositivo, libera spazio o riavvialo prima di toccare «Riprova». I dati salvati restano al sicuro."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontgrendel je apparaat, maak opslagruimte vrij of herstart het voordat je op ‘Probeer opnieuw’ tikt. Je opgeslagen gegevens blijven behouden."
          }
        }
      }
    },
