    "It becomes a top-level task in that list. Its parent task stays where it is." : {
      "comment" : "Explains, before a subtask is moved to another list on its own, that it will no longer be a subtask there.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wird in dieser Liste zu einer eigenständigen Aufgabe. Ihre übergeordnete Aufgabe bleibt, wo sie ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se convertirá en una tarea de nivel superior en esa lista. Su tarea principal se queda donde está."
