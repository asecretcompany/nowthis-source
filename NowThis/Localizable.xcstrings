    "pro.watch.body" : {
      "comment" : "Watch viewing and complications are permanently free. Only Watch task editing and cosmetic icons are paid benefits.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf der Apple Watch Aufgaben anzusehen und Komplikationen zu nutzen, ist immer kostenlos. Mit Supporter kannst du Aufgaben auf der Apple Watch abhaken und hinzufügen, auch per Sprache, und erhältst Unterstützer-App-Symbole."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viewing tasks and using complications on Apple Watch are always free. Supporter adds checking off and adding tasks on Apple Watch, including by voice, plus supporter app icons."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ver tareas y usar complicaciones en el Apple Watch siempre es gratis. Supporter añade la opción de marcar tareas como completadas y añadirlas en el Apple Watch, también con la voz, además de iconos de la app para quienes apoyan el desarrollo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La consultation des tâches et l’utilisation des complications sur l’Apple Watch sont toujours gratuites. Supporter permet de cocher et d’ajouter des tâches sur l’Apple Watch, y compris à la voix, et donne accès aux icônes de l’app réservées aux personnes qui soutiennent le développement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualizzare le attività e usare le complicazioni su Apple Watch è sempre gratuito. Supporter aggiunge la possibilità di contrassegnare come completate e aggiungere attività su Apple Watch, anche con la voce, oltre alle icone dell’app per chi sostiene lo sviluppo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taken bekijken en complicaties op de Apple Watch gebruiken is altijd gratis. Met Supporter kun je taken afvinken en toevoegen op de Apple Watch, ook met je stem, en krijg je supporterappsymbolen."
          }
        }
      }
    },
