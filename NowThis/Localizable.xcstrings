    "You can add a Nextcloud account later in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst später in den Einstellungen ein Nextcloud-Konto hinzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes añadir una cuenta de Nextcloud más adelante en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pourrez ajouter un compte Nextcloud plus tard dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi aggiungere un account Nextcloud in seguito in Impostazioni."
          }
        },
