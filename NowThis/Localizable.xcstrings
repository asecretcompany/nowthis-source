    "pro.support.body" : {
      "comment" : "Optional support funds development; no ads or tracking.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NowThis enthält keine Werbung und kein Tracking. Mit deiner Unterstützung finanzierst du die Weiterentwicklung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NowThis has no ads and no tracking. Becoming a Supporter helps fund continued development."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NowThis no tiene anuncios ni te rastrea. Hacerte Supporter ayuda a financiar el desarrollo continuo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NowThis n’affiche aucune publicité et ne vous suit pas. Devenir Supporter aide à financer la poursuite du développement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NowThis non contiene pubblicità e non ti traccia. Diventare Supporter aiuta a finanziare lo sviluppo continuo."
          }
