    },
    "Opens your Nextcloud server in a browser. Your Nextcloud password stays in the browser and never reaches this app; the server hands back a separate app password, which is stored in the iOS Keychain and can be revoked from Nextcloud at any time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet deinen Nextcloud-Server in einem Browser. Dein Nextcloud-Passwort bleibt im Browser und erreicht diese App nie; der Server gibt ein separates App-Passwort zurück, das im iOS-Schlüsselbund gespeichert wird und sich jederzeit in Nextcloud widerrufen lässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre tu servidor Nextcloud en un navegador. Tu contraseña de Nextcloud permanece en el navegador y nunca llega a esta app; el servidor devuelve una contraseña de aplicación aparte, que se guarda en el llavero de iOS y puedes revocar desde Nextcloud en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre votre serveur Nextcloud dans un navigateur. Votre mot de passe Nextcloud reste dans le navigateur et n'atteint jamais cette app ; le serveur renvoie un mot de passe d'application distinct, conservé dans le trousseau iOS et révocable à tout moment depuis Nextcloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre il tuo server Nextcloud in un browser. La tua password Nextcloud resta nel browser e non raggiunge mai questa app; il server restituisce una password per l'app separata, che viene salvata nel portachiavi di iOS e può essere revocata da Nextcloud in qualsiasi momento."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent je Nextcloud-server in een browser. Je Nextcloud-wachtwoord blijft in de browser en bereikt deze app nooit; de server geeft een apart app-wachtwoord terug, dat wordt bewaard in de iOS-sleutelhanger en op elk moment kan worden ingetrokken vanuit Nextcloud."
          }
        }
      }
    },
    "Original unavailable" : {
      "comment" : "The original cannot currently be accessed; the optimized preview remains usable.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original nicht verfügbar"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Original unavailable"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original no disponible"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original indisponible"
          }
        },
        "it" : {
          "stringUnit" : {
