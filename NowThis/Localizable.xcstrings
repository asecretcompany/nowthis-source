    "Applies only to new photos. Optimized previews are always available offline. Full-resolution originals are limited to 25 MB each." : {
      "comment" : "Changing the setting affects future imports only. Existing originals are not uploaded, removed, or reprocessed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt nur für neue Fotos. Optimierte Vorschaubilder sind immer offline verfügbar. Originale in voller Auflösung dürfen jeweils höchstens 25 MB groß sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Applies only to new photos. Optimized previews are always available offline. Full-resolution originals are limited to 25 MB each."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se aplica a las fotos nuevas. Las vistas previas optimizadas siempre están disponibles sin conexión. Los originales en resolución completa no pueden superar los 25 MB cada uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique uniquement aux nouvelles photos. Les aperçus optimisés sont toujours disponibles hors ligne. Chaque original en pleine résolution est limité à 25 Mo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si applica solo alle nuove foto. Le anteprime ottimizzate sono sempre disponibili offline. Ogni originale ad alta risoluzione può avere una dimensione massima di 25 MB."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geldt alleen voor nieuwe foto’s. Geoptimaliseerde voorvertoningen zijn altijd offline beschikbaar. Originele foto’s in volledige resolutie mogen maximaal 25 MB per stuk zijn."
          }
        }
      }
    },
    "Applies only to photos you add from now on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt nur für Fotos, die du ab jetzt hinzufügst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Applies only to photos you add from now on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
