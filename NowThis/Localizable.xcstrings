          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi vedere le foto in questo elenco, ma non hai più l’autorizzazione per modificarle."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
