    "pro.artwork.body" : {
      "comment" : "Paid-period artwork stays owned after expiry; lifetime includes all future Supporter benefits and art.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Jahr gibt es neue Unterstützer-Motive. Abonnent*innen behalten Sammlungen, die sie während bezahlter Zeiträume erhalten haben. Supporter auf Lebenszeit umfasst alle aktuellen und zukünftigen Supporter-Funktionen und -Motive."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New supporter artwork arrives each year. Subscribers keep collections earned during paid periods. Lifetime Supporter includes all current and future Supporter features and artwork."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada año llegan nuevos diseños para quienes apoyan el desarrollo. Quienes tienen una suscripción conservan las colecciones obtenidas durante los periodos de pago. Supporter de por vida incluye todas las funciones y diseños Supporter actuales y futuros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De nouveaux visuels de soutien arrivent chaque année. Les personnes abonnées conservent les collections obtenues pendant leurs périodes payées. Supporter à vie comprend toutes les fonctionnalités et tous les visuels Supporter actuels et futurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni anno arrivano nuove grafiche per chi sostiene lo sviluppo. Chi ha un abbonamento conserva le collezioni ottenute durante i periodi a pagamento. Supporter a vita include tutte le funzioni e le grafiche Supporter attuali e future."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk jaar komt er nieuwe supporterillustratie bij. Abonnees behouden collecties die ze tijdens betaalde periodes hebben verdiend. Supporter voor altijd omvat alle huidige en toekomstige Supporter-functies en -illustraties."
          }
        }
      }
    },
    "pro.buy.a11y.hint" : {
      "comment" : "Spoken purchase hint. Functional iOS and Watch viewing remain free.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
