          }
        }
      }
    },
    "You have an Apple Watch — unlock editing with NowThis Supporter" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast eine Apple Watch — schalte das Bearbeiten mit NowThis Supporter frei"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes un Apple Watch — desbloquea la edición con NowThis Supporter"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez une Apple Watch — débloquez la modification avec NowThis Supporter"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai un Apple Watch — sblocca la modifica con NowThis Supporter"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt een Apple Watch — ontgrendel bewerken met NowThis Supporter"
          }
        }
      }
    },
    "You have an Apple Watch. Unlock NowThis Supporter to check off and add tasks from your wrist." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast eine Apple Watch. Schalte NowThis Supporter frei, um Aufgaben direkt am Handgelenk abzuhaken und hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes un Apple Watch. Desbloquea NowThis Supporter para marcar y añadir tareas desde la muñeca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez une Apple Watch. Débloquez NowThis Supporter pour cocher et ajouter des tâches depuis votre poignet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai un Apple Watch. Sblocca NowThis Supporter per completare e aggiungere attività dal polso."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt een Apple Watch. Ontgrendel NowThis Supporter om taken af te vinken en toe te voegen vanaf je pols."
          }
        }
      }
    },
    "Your data never leaves your device or your server. Zero tracking." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten verlassen weder dein Gerät noch deinen Server. Kein Tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos nunca salen de tu dispositivo ni de tu servidor. Cero rastreo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données ne quittent jamais votre appareil ni votre serveur. Aucun suivi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati non lasciano mai il tuo dispositivo né il tuo server. Zero tracciamento."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gegevens verlaten nooit je apparaat of je server. Geen tracking."
          }
        }
      }
    },
    "Your task data couldn't be opened" : {
