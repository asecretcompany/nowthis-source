    "A friendly name shown in the sidebar and settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Name, der in der Seitenleiste und in den Einstellungen angezeigt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nombre reconocible que se muestra en la barra lateral y en los ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nom lisible affiché dans la barre latérale et dans les réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nome riconoscibile mostrato nella barra laterale e nelle impostazioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een herkenbare naam die in de navigatiekolom en in de instellingen wordt getoond."
          }
        }
      }
    },
    "A task photo could not be synced because its attachment is invalid or too large. Ask the list owner to replace it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Aufgabenfoto konnte nicht synchronisiert werden, weil der Anhang ungültig oder zu groß ist. Bitte den Listeninhaber, es zu ersetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A task photo could not be synced because its attachment is invalid or too large. Ask the list owner to replace it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido sincronizar una foto de la tarea porque el archivo adjunto no es válido o es demasiado grande. Pide al propietario de la lista que lo sustituya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une photo de la tâche n’a pas pu être synchronisée, car sa pièce jointe est invalide ou trop volumineuse. Demandez au propriétaire de la liste de la remplacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una foto dell’attività non è stata sincronizzata perché l’allegato non è valido o è troppo grande. Chiedi al proprietario dell’elenco di sostituirla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een taakfoto kon niet worden gesynchroniseerd omdat de bijlage ongeldig of te groot is. Vraag de lijsteigenaar om deze te vervangen."
          }
        }
      }
    },
